# Local execution uses real LangGraph + MCP, with an explicit local planning adapter.
APP_ENV=local
AGENT_HTTP_HOST=127.0.0.1
AGENT_HTTP_PORT=8090
AGENT_API_KEY=
AGENT_DEFAULT_REGION=US
AGENT_DEFAULT_LANGUAGE=en-US
AGENT_REGION_LANGUAGE_MAP_JSON={"US":"en-US","GB":"en-US","CA":"en-US","ID":"id-ID","TH":"th-TH","VN":"vi-VN","MY":"ms-MY","PH":"en-US","JP":"ja-JP"}
AGENT_PLANNER_TEMPERATURE=0.0
AGENT_PLANNER_MAX_TOKENS=2048
AGENT_MAX_QUERIES_PER_PLAN=6
PLANNER_BACKEND=rules

JAVA_GATEWAY_URL=http://127.0.0.1:8080
# Known local identity endpoint; TODO: choose the production identity endpoint.
# 本地通过 Java 网关核验 Bearer；独立启动时不用复制 Java 进程的内部密钥。
IDENTITY_SERVICE_URL=http://127.0.0.1:8080
# CLI/examples only: obtain a user JWT by login in this process; never persist a token in this file.
# FLMH_USER_TOKEN is read from the current process environment.
# TODO: set this equal to Java FLMH_SERVICE_API_KEY before enabling production auth.
JAVA_GATEWAY_API_KEY=
# TODO: explicit TCP proxy CIDRs, comma separated; empty trusts no forwarded identity address.
# Trusted proxies must send one X-Flmh-Client-IP and the configured internal X-Service-Key.
# Standard Forwarded/X-Forwarded-For and Uvicorn environment overrides are not trusted.
AGENT_TRUSTED_PROXY_CIDRS=
MODEL_GATEWAY_URL=http://127.0.0.1:8082
# TODO: set this equal to Java FLMH_SERVICE_API_KEY before enabling production auth.
MODEL_GATEWAY_API_KEY=
MCP_TOOLS_URL=http://127.0.0.1:8001/mcp
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8001
REQUEST_TIMEOUT_SECONDS=15

# TODO: choose the PostgreSQL endpoint and credentials source before enabling postgres.
CHECKPOINTER_BACKEND=memory
POSTGRES_CHECKPOINTER_URI=
# True initializes LangGraph checkpoints and the Agent session directory table/indexes.
# Enable only for explicit setup with the intended database role.
POSTGRES_CHECKPOINT_SETUP=false

# TODO: choose the Langfuse endpoint and key source.
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# TODO: choose deployed BGE-M3/BGE-Reranker endpoints and model identifiers.
EMBEDDING_BACKEND=
BGE_M3_URL=
BGE_M3_MODEL=
BGE_M3_API_KEY=
# TODO: set the dimension returned by the selected embedding deployment.
BGE_M3_DIMENSION=
BGE_RERANKER_URL=
BGE_RERANKER_MODEL=
BGE_RERANKER_API_KEY=

# TODO: choose the Elasticsearch endpoint and knowledge namespace for RAG.
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
# Namespace prefix, not an existing concrete index. Published document aliases use <prefix>-active-*.
# 1-80 lowercase letters/digits/_/-; start with a letter or digit. Existing old indices are not migrated.
ELASTICSEARCH_INDEX=
ELASTICSEARCH_DENSE_FIELD=dense_vector
ELASTICSEARCH_SPARSE_FIELD=sparse_vector
RAG_TOP_K=5
RAG_CANDIDATE_MULTIPLIER=4
RAG_RRF_K=60
RAG_PIT_KEEP_ALIVE=1m
RAG_LOCAL_CORPUS_FALLBACK=false
# Immutable revision of the indexed corpus for cross-turn evidence reuse.
RAG_CORPUS_VERSION=

# TODO: use a dedicated read-only MySQL or PostgreSQL role; never share checkpointer write credentials.
BI_DATABASE_URI=
SQL_DIALECT=mysql
SQL_MAX_ROWS=50
SQL_TIMEOUT_MS=5000
SQL_MAX_RETRIES=3
SQL_DEFAULT_SCORE_VERSION=v2
SQL_DAILY_SCORE_VERSION=radar-v2-exact-date
# Verified USER/ADMIN/SUPER_ADMIN -> authorized product/creator table names. Empty means no BI access.
BI_SQL_ROLE_TABLES_JSON=
