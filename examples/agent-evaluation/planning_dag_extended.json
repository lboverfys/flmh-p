      "request": "对比美国、加拿大、英国、印尼、泰国、越南六个市场的便携风扇",
      "expected_batches": [["query-1", "query-2", "query-3", "query-4", "query-5", "query-6"]],
      "expected_regions": ["US", "CA", "GB", "ID", "TH", "VN"]
    },
    {
      "id": "th-fan-trend-only",
      "request": "查泰国便携风扇近30天销量走势",
      "expected_batches": [["q_catalog"], ["q_trend"]],
      "expected_tool_kinds": ["product_search", "product_trend"]
    },
    {
      "id": "vn-tumbler-creators-only",
      "request": "查越南钛制保温杯的带货达人推荐",
      "expected_batches": [["q_catalog"], ["q_creators"]],
      "expected_tool_kinds": ["product_search", "product_creators"]
